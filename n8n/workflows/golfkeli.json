    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst members = data[\"wfs:FeatureCollection\"][\"wfs:member\"];\n\nconst FIELD_NAMES = {\n  \"Temperature\": \"temp\",\n  \"WindSpeedMS\": \"wind\",\n  \"Precipitation1h\": \"rain\",\n};\n\nconst ZONE = \"Europe/Helsinki\";\nconst tomorrow = DateTime.now().setZone(ZONE).plus({ days: 1 }).toISODate();\n\nconst byTime = {};\n\nfor (const m of members) {\n  const el = m[\"BsWfs:BsWfsElement\"];\n  const time = el[\"BsWfs:Time\"];\n  const field = FIELD_NAMES[el[\"BsWfs:ParameterName\"]];\n  const value = parseFloat(el[\"BsWfs:ParameterValue\"]);\n\n  if (!field) continue; \n\n  if (!(time in byTime)) {\n    byTime[time] = { time: time };\n  }\n  byTime[time][field] = value;\n}\n\nconst hours = [];\n\nfor (const h of Object.values(byTime)) {\n  const local = DateTime.fromISO(h.time, { zone: \"utc\" }).setZone(ZONE);\n  if (local.toISODate() !== tomorrow) continue;\n\n  hours.push({\n    hour: local.hour,\n    wind: h.wind,\n    temp: h.temp,\n    rain: h.rain,\n  });\n}\n\nreturn [{ json: { date: tomorrow, hours: hours } }];\n\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
